{
  "name": "mcd2speedrunning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "validate": "node scripts/validate-content.mjs",
    "audit": "node scripts/migration-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate && npm run typecheck && node scripts/write-revision.mjs && vite build",
    "check": "npm test && npm run smoke && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "node scripts/render-smoke.mjs",
    "revision": "node scripts/refresh-revision.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1"
  }
}
